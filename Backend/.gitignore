# ──────────────────────────────────────────────────────────────
# UpSkillr — Backend .gitignore
# Node.js / Express / MongoDB
# ──────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnpm-store/
jspm_packages/

# Environment Variables (NEVER commit secrets)
.env
.env.*
!.env.example
*.env

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build & Compiled Outputs
build/
dist/
dist-ssr/
out/
coverage/
.nyc_output/

# Testing
test-results/
*.test-report.json

# Runtime & OS Artifacts
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.Spotlight-V100
.Trashes

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?

# Misc
*.local
*.tsbuildinfo
.cache/
