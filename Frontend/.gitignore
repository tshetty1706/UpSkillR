# ──────────────────────────────────────────────────────────────
# UpSkillr — Frontend .gitignore
# React 19 + Vite + Vanilla CSS
# ──────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnpm-store/
jspm_packages/

# Environment Variables (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.env

# Production Build Outputs
dist/
dist-ssr/
build/
out/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite Cache & Temporary Files
.vite/
.cache/
.turbo/
.eslintcache
*.tsbuildinfo

# Testing & Coverage
coverage/
.nyc_output/
test-results/
*.test-report.json

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Misc
*.local
